        QMainWindow, QDialog {{
            background-color: {bg};
            color: {text};
        }}
        QWidget {{
            color: {text};
            font-family: "Segoe UI", system-ui, sans-serif;
            font-size: 14px;
            background: transparent;
        }}

QToolTip {{
    background-color: {surface};
    color: {text};
    border: 1px solid {border};
    padding: 6px 8px;
    border-radius: 6px;
}}

/* Header and footer */
#HeaderFrame, #FooterFrame {{
    background-color: {bg};
    border: none;
}}

#HeaderFrame {{
    border-bottom: 1px solid {border};
}}

#FooterFrame {{
    border-top: 1px solid {border};
}}

QLabel#AppName {{
    font-family: "Consolas", monospace;
    font-weight: 600;
    font-size: 16px;
    color: {text};
}}

QLabel#Crumb {{
    font-family: "Consolas", monospace;
    font-size: 12px;
    color: {text_muted};
}}

QLabel#ModeLabel {{
    font-family: "Consolas", monospace;
    font-size: 12px;
    color: {text_muted};
    padding-right: 8px;
}}

/* Sidebar */
#Sidebar {{
    background-color: {sidebar};
    border-right: 1px solid {border};
}}

QPushButton#NavBtn {{
    text-align: left;
    padding: 10px 12px;
    font-size: 14px;
    font-weight: 500;
    color: {text_muted};
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
}}

QPushButton#NavBtn:hover {{
    background-color: {surface_alt};
    color: {text};
}}

QPushButton#NavBtn:checked {{
    background-color: {accent_subtle};
    color: {accent};
    border: 1px solid {accent};
}}

QLabel#NavTitle {{
    font-family: "Consolas", monospace;
    font-size: 10px;
    font-weight: 600;
    color: {text_faint};
    padding: 0 12px;
    margin-top: 16px;
}}

/* Status area */
#StatusFrame {{
    border-top: 1px solid {border};
    padding: 16px;
    background-color: {sidebar};
}}

QFrame#StatusCard {{
    background-color: {surface_alt};
    border: 1px solid {border};
    border-radius: 8px;
}}

QLabel#StatusText {{
    font-size: 12px;
    color: {text_muted};
}}

QPushButton#ActionLink {{
    color: {accent};
    background: transparent;
    border: none;
    font-size: 11px;
    font-family: "Consolas", monospace;
    text-align: left;
    padding: 0;
}}

QPushButton#ActionLink:hover {{
    color: {accent_hover};
}}

/* Cards */
QFrame#Card {{
    background-color: {surface};
    border: 1px solid {border};
    border-radius: 8px;
}}

QLabel#CardTitle {{
    font-family: "Consolas", monospace;
    font-size: 12px;
    font-weight: 600;
    color: {text_muted};
    letter-spacing: 0.4px;
    margin-bottom: 12px;
}}

QLabel#ReqBadge {{
    font-size: 10px;
    color: {primary};
    background-color: {primary_subtle};
    border: 1px solid {primary};
    padding: 2px 6px;
    border-radius: 4px;
    font-family: "Segoe UI", sans-serif;
    font-weight: normal;
}}

QLabel#Subhead {{
    font-family: "Consolas", monospace;
    font-size: 11px;
    color: {text_faint};
    letter-spacing: 0.4px;
    margin-top: 16px;
    margin-bottom: 8px;
    border-top: 1px solid {border};
    padding-top: 12px;
}}

QLabel#FieldLabel {{
    font-size: 13px;
    font-weight: 500;
    color: {text};
}}

QLabel#Hint {{
    font-size: 12px;
    color: {text_muted};
}}

QLabel#Hint a {{
    color: {accent};
    text-decoration: none;
}}

QLabel#Hint a:hover {{
    text-decoration: underline;
}}

QLabel#WarningHint {{
    font-size: 12px;
    font-weight: 500;
    color: {warning};
}}

/* Inputs */
QLineEdit,
QComboBox,
QSpinBox,
QPlainTextEdit {{
    background-color: {input_bg};
    border: 1px solid {border_strong};
    color: {text};
    padding: 9px 11px;
    border-radius: 6px;
    font-size: 14px;
    selection-background-color: {accent};
    selection-color: {on_primary};
}}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QPlainTextEdit:hover {{
    border-color: {accent};
}}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QPlainTextEdit:focus {{
    border: 1px solid {accent};
    background-color: {input_focus_bg};
}}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QPlainTextEdit:disabled {{
    background-color: {surface_alt};
    color: {text_faint};
    border-color: {border};
}}

QLineEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {{
    background-color: {surface_alt};
    color: {text_muted};
}}

QComboBox::drop-down {{
    border: none;
    width: 20px;
}}

QComboBox QAbstractItemView {{
    background-color: {surface};
    color: {text};
    selection-background-color: {accent_subtle};
    selection-color: {accent};
    border: 1px solid {border};
}}

        /* ---- Item-view headers: explicit so they don't fall back to black under an app stylesheet ---- */
        QHeaderView {{
            background-color: {surface_alt};
            border: none;
        }}
        QHeaderView::section {{
            background-color: {surface_alt};
            color: {text_muted};
            border: none;
            border-right: 1px solid {border};
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 600;
        }}
        QHeaderView::section:last {{
            border-right: none;
        }}
        /* keep the dialog's tree/list body on a real plane too (rows already read from palette Base) */
        QAbstractItemView {{
            background-color: {surface};
            color: {text};
            border: 1px solid {border};
            outline: 0;
        }}
        QAbstractItemView::item:selected {{
            background-color: {accent_subtle};
            color: {accent};
        }}

QCheckBox {{
    color: {text};
    spacing: 8px;
}}

QCheckBox:disabled {{
    color: {text_faint};
}}

        /* ---- Check / radio indicators: explicit so they survive QSS styled-mode ---- */
        QCheckBox::indicator,
        QRadioButton::indicator {{
            width: 16px;
            height: 16px;
            border: 1px solid {border_strong};
            border-radius: 4px;
            background-color: {input_bg};
        }}
        QCheckBox::indicator:hover,
        QRadioButton::indicator:hover {{
            border-color: {accent};
        }}
        QCheckBox::indicator:checked,
        QRadioButton::indicator:checked {{
            background-color: {accent};
            border-color: {accent};
        }}
        QCheckBox::indicator:checked {{
            image: url("{check_icon}");
        }}
        QCheckBox::indicator:disabled,
        QRadioButton::indicator:disabled {{
            background-color: {surface_alt};
            border-color: {border};
        }}
        QRadioButton::indicator {{
            border-radius: 8px;
        }}
        /* ---- Combo / spin arrows: CSS triangles, no image files needed ---- */
        QComboBox::down-arrow {{
            width: 0; height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-top: 5px solid {text_muted};
            margin-right: 6px;
        }}
        QSpinBox::up-arrow {{
            width: 0; height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-bottom: 5px solid {text_muted};
        }}
        QSpinBox::down-arrow {{
            width: 0; height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-top: 5px solid {text_muted};
        }}

/* Buttons */
QPushButton {{
    background-color: {button_bg};
    color: {text};
    border: 1px solid {border};
    border-radius: 6px;
    padding: 8px 16px;
}}

QPushButton:hover {{
    background-color: {button_hover};
}}

QPushButton:disabled {{
    background-color: {surface_alt};
    color: {text_faint};
    border-color: {border};
}}

QPushButton#BtnRun {{
    background-color: {primary};
    color: {on_primary};
    border: none;
    border-radius: 7px;
    padding: 10px 18px;
    font-weight: 600;
    font-size: 13.5px;
}}

QPushButton#BtnRun:hover {{
    background-color: {primary_hover};
}}

QPushButton#BtnRun:disabled {{
    background-color: {surface_alt};
    color: {text_faint};
    border: 1px solid {border};
}}

QPushButton#BtnPreview {{
    background-color: {accent_subtle};
    color: {accent};
    border: 1px solid {accent};
    border-radius: 7px;
    padding: 10px 18px;
    font-weight: 600;
    font-size: 13.5px;
}}

QPushButton#BtnPreview:hover {{
    background-color: {button_hover};
}}

QPushButton#BtnPreview:disabled {{
    background-color: {surface_alt};
    color: {text_faint};
    border-color: {border};
}}

        /* ---- Tabs (Upload / Archive sub-navigation) ---- */
        QTabWidget {{
            background: transparent;
            border: none;
        }}
        QTabWidget::pane {{
            border: none;
            background: transparent;
        }}
        QTabBar {{
            background: transparent;
            spacing: 6px;
        }}
        QTabBar::tab {{
            background: transparent;
            color: {text_muted};
            border: 1px solid transparent;
            border-radius: 7px;
            padding: 8px 18px;
            font-size: 13.5px;
            font-weight: 600;
        }}
        QTabBar::tab:hover:!selected {{
            color: {text};
            background-color: {button_hover};
        }}
        QTabBar::tab:selected {{
            color: {accent};
            background-color: {accent_subtle};
            border: 1px solid {accent};
        }}

/* Dialogs */
QDialog {{
    background-color: {surface};
    color: {text};
    border: 1px solid {border};
    border-radius: 12px;
}}

QLabel#DlgKicker {{
    font-family: "Consolas", monospace;
    font-size: 11px;
    color: {text_faint};
    letter-spacing: 0.4px;
}}

QLabel#DlgTitle {{
    font-size: 18px;
    font-weight: 600;
    color: {text};
}}

QLabel#DlgDesc {{
    font-size: 13px;
    color: {text_muted};
}}

QPlainTextEdit#CmdBlock {{
    background-color: {terminal_bg};
    border: 1px solid {border};
    color: {terminal_text};
    font-family: "Consolas", monospace;
    font-size: 13px;
    border-radius: 8px;
    padding: 16px;
}}

/* Progress */
QProgressBar {{
    border: 1px solid {border};
    border-radius: 6px;
    background-color: {surface_alt};
    color: {text};
    height: 18px;
    text-align: center;
}}

QProgressBar::chunk {{
    background-color: {accent};
    border-radius: 5px;
}}

/* Scroll areas */
QScrollArea {{
    border: none;
    background-color: {bg};
}}

QScrollBar:vertical {{
    border: none;
    background: {scrollbar};
    width: 8px;
    margin: 0;
}}

QScrollBar::handle:vertical {{
    background: {scrollbar_handle};
    min-height: 20px;
    border-radius: 4px;
}}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {{
    height: 0;
}}

QScrollBar:horizontal {{
    border: none;
    background: {scrollbar};
    height: 8px;
    margin: 0;
}}

QScrollBar::handle:horizontal {{
    background: {scrollbar_handle};
    min-width: 20px;
    border-radius: 4px;
}}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {{
    width: 0;
}}

/* Menus */
QMenuBar {{
    background-color: {bg};
    color: {text};
    border-bottom: 1px solid {border};
}}

QMenuBar::item {{
    background: transparent;
    padding: 6px 10px;
}}

QMenuBar::item:selected {{
    background-color: {surface_alt};
}}

QMenu {{
    background-color: {surface};
    color: {text};
    border: 1px solid {border};
}}

QMenu::item {{
    padding: 6px 24px;
}}

QMenu::item:selected {{
    background-color: {accent_subtle};
    color: {accent};
}}
